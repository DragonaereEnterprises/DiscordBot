{
  "name": "bot",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "exports": "./index.ts",
  "tasks": {
    "start": "deno run -A --env-file=.env index.ts",
    "dev": "deno run -A --watch --env-file=.env index.ts",
    "lint": "biome lint --write",
    "lavalink": "pm2 start --name Lavalink java -- -jar Lavalink.jar",
    "stop-lavalink": "pm2 kill"
  },
  "imports": {
    "@andrewdragon/utils": "npm:@andrewdragon/utils@^1.0.0",
    "@apollo/server": "npm:@apollo/server@^5.5.1",
    "@as-integrations/express5": "npm:@as-integrations/express5@^1.1.2",
    "cors": "npm:cors@^2.8.6",
    "discord.js": "npm:discord.js@14.27.0",
    "express": "npm:express@5.2.1",
    "graphql": "npm:graphql@^16.14.2",
    "lavalink-client": "npm:lavalink-client@^2.11.0",
    "ms": "npm:ms@^2.1.3",
    "pino": "npm:pino@10.3.1",
    "pino-pretty": "npm:pino-pretty@13.1.3",
    "reacord": "npm:reacord@^0.6.0",
    "react": "npm:react@18.3.1"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": ["npm:@apollo/protobufjs@1.2.8"],
    "deny": ["npm:esbuild@0.28.2", "npm:fsevents@2.3.3"]
  }
}